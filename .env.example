# Core Project Information
PROJECT_NAME="HAIDER AI"
PROJECT_SUBTITLE="Your Intelligent Personal AI Assistant"
DEVELOPER_NAME="Syed Haider Ali"
DEVELOPER_GITHUB="https://github.com/syedhaiderali-0164"
DEVELOPER_LINKEDIN="https://www.linkedin.com/in/haider-ali-1447bb3a/"
VERSION="1.0.0"

# Application Environment (development | production)
ENVIRONMENT="development"

# Security & Authentication (Replace SECRET_KEY with a random 64-char string in production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="generate_a_secure_jwt_secret_key_for_production_use"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM="HS256"

# Database Configuration
# Local SQLite (default fallback):
DATABASE_URL="sqlite+aiosqlite:///./haider_ai.db"
SYNC_DATABASE_URL="sqlite:///./haider_ai.db"

# Production Managed PostgreSQL (Uncomment and replace with your connection string):
# DATABASE_URL="postgresql+asyncpg://postgres:your_db_password@localhost:5432/haider_ai"
# SYNC_DATABASE_URL="postgresql://postgres:your_db_password@localhost:5432/haider_ai"

# CORS Configuration (Comma-separated list of allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=25

# Default AI Provider Configuration (Can also be set per-user in UI Settings)
DEFAULT_AI_PROVIDER="openai"
DEFAULT_AI_BASE_URL="https://api.openai.com/v1"
DEFAULT_AI_MODEL="gpt-4o-mini"
DEFAULT_AI_API_KEY=""

# Optional Groq Provider Settings:
# DEFAULT_AI_PROVIDER="groq"
# DEFAULT_AI_BASE_URL="https://api.groq.com/openai/v1"
# DEFAULT_AI_MODEL="llama-3.3-70b-versatile"
# DEFAULT_AI_API_KEY="gsk_..."

